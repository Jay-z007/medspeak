# ==============================================================================
# MedSpeak - Environment Configuration Template
# Copy this file to .env before running the application.
# NEVER commit actual secrets or credentials to source control.
# ==============================================================================

# Backend Service Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini API Configuration (Server-Side Only - NEVER expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Rime TTS Configuration (Server-Side Only - NEVER expose to frontend)
RIME_API_KEY=your_rime_api_key_here
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_MODEL_ID=coda
RIME_SPEAKER=astra
RIME_LANGUAGE=en
RIME_AUDIO_FORMAT=mp3
RIME_SAMPLING_RATE=24000

# Fallback TTS Configuration (Optional)
FALLBACK_TTS_ENABLED=False
FALLBACK_TTS_PROVIDER=edge_tts

# Speech-to-Text (STT) Configuration
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=tiny.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Production Deployment Settings:
#
# For Render (Backend):
# - Set CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# - Set RIME_API_KEY=your_rime_secret_key
# - Set GEMINI_API_KEY=your_gemini_secret_key
#
# For Vercel (Frontend):
# - Set NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Frontend Environment Variables (Exposed to Next.js Browser Client)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
