# ==============================================================================
# MedSpeak Backend - Environment Configuration Template
# Copy this file to backend/.env before running the application.
# NEVER commit actual secrets or credentials to source control.
# ==============================================================================

# Application Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Gemini API Configuration (Server-Side Only - NEVER expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Rime TTS Configuration (Server-Side Only - NEVER expose to frontend)
RIME_API_KEY=
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_MODEL_ID=coda
RIME_SPEAKER=astra
RIME_LANGUAGE=en
RIME_AUDIO_FORMAT=mp3
RIME_SAMPLING_RATE=24000

# Fallback TTS Configuration (Optional)
FALLBACK_TTS_ENABLED=False
FALLBACK_TTS_PROVIDER=edge_tts

# Speech-to-Text (STT) Configuration
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=tiny.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Storage & Database
DATABASE_URL=sqlite:///./data/medspeak.db
